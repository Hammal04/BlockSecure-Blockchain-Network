# Copy this file to .env and set paths for your local Fabric test-network.
# Never commit the real .env file or private key.

PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_TLS_SERVER_NAME=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_MSP_ID=Org1MSP
FABRIC_IDENTITY_CERT_PATH=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
# Set the exact private-key filename found inside this user's keystore directory.
FABRIC_IDENTITY_PRIVATE_KEY_PATH=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk

# Optional: use a separate application signing key. If blank, the smoke-test helper reuses the Fabric identity key.
BLOCKSECURE_SIGNING_PRIVATE_KEY_PATH=
BLOCKSECURE_SIGNING_ALGORITHM=ECDSA-SHA256

FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=blocksecure
